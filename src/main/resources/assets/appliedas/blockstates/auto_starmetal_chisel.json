{
  "multipart": [
    {
      "apply": {
        "model": "appliedas:block/auto_starmetal_chisel"
      }
    },
    {
      "when": {
        "active": "true"
      },
      "apply": {
        "model": "appliedas:block/auto_starmetal_chisel_glow"
      }
    },
    {
      "when": {
        "lit": "true",
        "active": "false"
      },
      "apply": {
        "model": "appliedas:block/auto_starmetal_chisel_glow_steady"
      }
    },
    {
      "when": {
        "lit": "false",
        "active": "false"
      },
      "apply": {
        "model": "appliedas:block/auto_starmetal_chisel_glow_off"
      }
    }
  ]
}
